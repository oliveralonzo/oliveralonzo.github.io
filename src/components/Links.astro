---
import Separator from "./Separator.astro";
const { links } = Astro.props;

---

<div>
    <ul class="flex">
        {
            Object.values(links).map((link, i, arr) => (
                <li>
                    {link.url ? (
                        <a href={link.url} target="_blank" rel="noopener noreferrer">
                            {link.showas}
                        </a>
                    ) : (
                        <span>{link.showas}</span>
                    )}
                    {i !== arr.length - 1 && <Separator />}
                </li>
            ))
        }
    </ul>
</div>
